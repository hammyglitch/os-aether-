.community-section{ position:relative; padding:4.5rem 4vw; background: radial-gradient(ellipse at 20% 15%, rgba(139,92,246,0.12), transparent 55%), radial-gradient(ellipse at 82% 78%, rgba(0,200,220,0.12), transparent 55%), var(--navy); overflow:hidden; }
