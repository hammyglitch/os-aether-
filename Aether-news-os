<script>
var cyberIndex = 0;
function cyberCarouselMove(dir){
  var grid = document.getElementById('cyber-card-grid');
  var cards = grid.querySelectorAll('.cyber-card');
  if(cards.length === 0) return;
  cyberIndex = Math.max(0, Math.min(cards.length - 1, cyberIndex + dir));
  grid.style.transform = 'translateX(-' + (cyberIndex * 100) + '%)';
}
function updateCyberArrows(){
  var grid = document.getElementById('cyber-card-grid');
  var cards = grid.querySelectorAll('.cyber-card');
  var showArrows = window.innerWidth > 1100 && cards.length > 1;
  var leftBtn = document.getElementById('cyber-arrow-left');
  var rightBtn = document.getElementById('cyber-arrow-right');
  leftBtn.style.display = showArrows ? 'flex' : 'none';
  rightBtn.style.display = showArrows ? 'flex' : 'none';
  leftBtn.style.alignItems = 'center';
  leftBtn.style.justifyContent = 'center';
  rightBtn.style.alignItems = 'center';
  rightBtn.style.justifyContent = 'center';
}
function initCyberCards(){
  document.querySelectorAll('.cyber-card').forEach(function(card){
    if(card.dataset.wired) return;
    card.dataset.wired = "1";
    card.addEventListener('click', function(){
      var id = card.getAttribute('data-card-id');
      var dataDiv = document.querySelector('.cyber-modal-data[data-card-id="' + id + '"]');
      if(!dataDiv) return;
      document.getElementById('modal-headline').textContent = dataDiv.querySelector('.modal-headline').textContent;
      document.getElementById('modal-date').textContent = dataDiv.querySelector('.modal-date').textContent;
      document.getElementById('modal-img').src = dataDiv.querySelector('.modal-image').textContent;
      document.getElementById('modal-summary').textContent = dataDiv.querySelector('.modal-summary').textContent;
      document.getElementById('modal-impact').textContent = dataDiv.querySelector('.modal-impact').textContent;
      document.getElementById('modal-outcomes').textContent = dataDiv.querySelector('.modal-outcomes').textContent;
      document.getElementById('cyber-article-modal').style.display = 'flex';
    });
  });
  updateCyberArrows();
}
function closeCyberModal(){
  document.getElementById('cyber-article-modal').style.display = 'none';
}
var currentLiked = false;
function toggleModalLike(){
  var countEl = document.getElementById('like-count');
  var iconEl = document.getElementById('like-icon');
  var count = parseInt(countEl.textContent);
  if(currentLiked){
    countEl.textContent = count - 1;
    iconEl.textContent = '♡';
  } else {
    countEl.textContent = count + 1;
    iconEl.textContent = '♥';
  }
  currentLiked = !currentLiked;
}
document.addEventListener('DOMContentLoaded', function(){ initCyberCards(); updateCyberArrows(); });
window.addEventListener('resize', updateCyberArrows);
new MutationObserver(function(){ initCyberCards(); updateCyberArrows(); }).observe(document.getElementById('cyber-card-grid'), {childList:true, subtree:true});
</script>

