.scraper-content li::before { content: '>'; color: var(--gold); font-family: var(--mono); font-weight: 700; }
.scraper-content li:last-child { border-bottom: none; }

.testimonial { background: var(--white); border: 2px solid var(--gold); border-radius: var(--radius); padding: 32px; text-align: center; margin: 28px 24px 0; max-width: 720px; margin-left: auto; margin-right: auto; }
.testimonial p { font-family: var(--serif); font-size: 1.2rem; font-style: italic; color: var(--ink); line-height: 1.6; margin-bottom: 12px; }
