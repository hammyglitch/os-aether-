.section-tag.tech { color: var(--gold); }
.section-tag.feature { color: var(--gold); }
.section-tag.defence { color: var(--red); }
.story h2 { font-family: var(--serif); font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
.story h2 a { color: var(--ink); transition: color 0.2s; }
.story h2 a:hover { color: var(--gold); }
.story p { font-size: 0.9rem; color: var(--muted); line-height: 1.55; }
.story-meta { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.03em; }

.most-read-item { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; gap: 12px; align-items: flex-start; transition: background 0.2s; }
.most-read-item:last-child { border-bottom: none; }
.most-read-item:hover { background: var(--bg); }
.most-read-num { font-family: var(--orbitron); font-size: 1.5rem; font-weight: 900; color: var(--gold); line-height: 1; min-width: 30px; }
.most-read-title { font-family: var(--serif); font-size: 0.95rem; font-weight: 600; color: var(--ink); line-height: 1.35; cursor: pointer; transition: color 0.2s; }
.most-read-title:hover { color: var(--gold); }

.scraper-section { padding: 16px 18px; border-bottom: 1px solid var(--border); background: var(--bg); }
