.community-hub{ position:relative; display:grid; grid-template-columns:1fr 1.2fr 1fr; grid-template-rows:auto auto auto; grid-template-areas: "tl tc tr" "ml centre mr" "bl bc br"; gap:1.1rem; max-width:1180px; margin:0 auto; align-items:stretch; }
